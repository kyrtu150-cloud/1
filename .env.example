# ===========================================================================
#  СОК.ai — конфигурация подключения нейросетей
# ---------------------------------------------------------------------------
#  Скопируйте этот файл в `.env` и заполните ключами реальных провайдеров.
#  Все переменные начинаются с VITE_, чтобы быть доступными на фронтенде.
#  Подробнее о том, как подключить свой провайдер — см. src/lib/api/README
#  и src/lib/api/providers/.
# ===========================================================================

# Какой провайдер генерации использовать по умолчанию:
#   mock            — демо-режим без реального API (возвращает примеры)
#   openai          — OpenAI Images / совместимый эндпоинт
#   replicate       — Replicate (SDXL, Flux и т.д.)
#   custom          — ваш собственный бэкенд (см. providers/custom.ts)
VITE_GENERATION_PROVIDER=mock

# --- OpenAI / совместимый ---------------------------------------------------
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_IMAGE_MODEL=gpt-image-1

# --- Replicate --------------------------------------------------------------
VITE_REPLICATE_API_TOKEN=
VITE_REPLICATE_MODEL=black-forest-labs/flux-1.1-pro

# --- Свой бэкенд ------------------------------------------------------------
VITE_CUSTOM_API_BASE_URL=
VITE_CUSTOM_API_KEY=
